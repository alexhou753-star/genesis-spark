{
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "module": "nodenext",
    "types": [],
    "outDir": "out",
    "composite": true,
    "declaration": true,
    "moduleResolution": "nodenext",
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../configs"
    }
  ],
  "exclude": [
    "test"
  ]
}
