/**
 * 创世火种 · @genesis/engine 状态与命令类型 v0.4（草案，待架构师评审后冻结）
 * 位置：packages/engine/src/types.ts。只允许 import @genesis/configs 的类型（架构 3.1）。
 *
 * v0.4 增补：profileId 谱系、subMilli 整数毫秒进度、diplomacy 随机流与外交权威状态、remainingMs 亚 tick 续算，
 * 以及通用事件契约（atMilli / seq / group / kind / payload，组序与诊断均可表达）。
 *
 * v0.4.1 增补（批次二/B 组）：TIMER 事件负载的 timer 联合追加 'government_cooldown' | 'failure_duration' |
 *   'neighbor_slow_change'（事件点 7 注册表成员，M2/M3 开工前登记口径的固化）。仅追加成员，不破坏已有联合。
 *
 * v0.4.1 增补（批次三/C 组）：新增政体 GovernmentState（挂 RunState.government）、失败梯度 FailureState
 *   （挂 RunState.failure）、母星折叠 HomeworldFoldState（挂 RunState.homeworldFold）；GameCommand 追加
 *   GOVERNMENT_CHOOSE。仅追加类型 / 字段 / 命令成员，不破坏已有联合。
 *
 * v0.3 增补：UniverseRecord / universeId / starLevel（FR-25、26 入存档）、QueueItem 的最大可接受成本与暂停、RESET 带宇宙与星级。
 *
 * v0.2 相对 v0.1 的变更：
 *  1. RESET 命令携带 seed 与 runId：引擎不读时钟、不生成随机数（架构 5.1），新周目的种子与周目 ID 必须由调用方给，
 *     且必须随命令进入输入日志，否则回放无法复现。
 *  2. 移除 OrdersState.highWaterMs：最大已观测系统时间戳是挂钟数据，属存档层的时间保护（FR-32），
 *     放进引擎状态会让引擎状态依赖挂钟，并进入规范状态哈希。已移到 @genesis/save 的 TimeGuard。
 *  3. 文档化“规范状态哈希覆盖范围”：perma、run、rng、meta 中的 currentTick / tickMs / runId / isTutorialRun。
 *     架构 7.4 / 7.5 原文只写 perma 与 run 两段，会漏掉随机数状态与当前 tick；已同步修订架构文档。
 *  4. 季节不入状态：当前季节与剩余时间由 currentTick 与 clock.seasonSec 推导（暂停时 tick 不走，天然满足 FR-10）。
 */

import type { BuildingId, GameNum, Id, JobId, ModifierConfig, RaceId, ResId, TechId } from '../configs/types';

export type SeedId = Id;
export type CatalystId = Id;

/** 命名流随机数，每条流独立的 Mulberry32，32 位整数状态（架构 5.2）。 */
export type RngStream = 'hazard' | 'eco' | 'tutorial' | 'diplomacy';

// ---------------------------------------------------------------------------
// 修饰器（运行时）
// ---------------------------------------------------------------------------

export type ModifierSource = 'race' | 'tech' | 'catalyst' | 'prestige' | 'universe' | 'event' | 'tutorial' | 'season';

export interface Modifier extends ModifierConfig {
  id: string;
  source: ModifierSource;
  /** 来源配置 ID，供 FR-44 数值来源分解面板使用（V1.0 不做界面）。 */
  sourceId: Id;
}

// ---------------------------------------------------------------------------
// 状态：可序列化的普通对象
// ---------------------------------------------------------------------------

export interface GameState {
  meta: StateMeta;
  rng: Record<RngStream, number>;
  /** 永久成长：重置不会清除（ADR-11）。 */
  perma: PermaState;
  /** 周目数据：重置时整体替换。 */
  run: RunState;
}

export interface StateMeta {
  engineVersion: number;
  schemaVersion: number;
  configVersion: number;
  tickMs: number;
  currentTick: number;
  /** 当前整 tick 内已消费的整数毫秒，满足 0 <= subMilli < tickMs；随存档及规范哈希保存。 */
  subMilli: number;
  runId: string;
  /** 宿主持久化提交边界，用于 WAL 幂等去重；属于存档元信息，不参与玩法公式。 */
  lastAppliedCmdSeq: number;
  /** 仅可选教学沙盒可置真；其产出、成就与随机流不得进入正常永久成长。 */
  isPracticeRun: boolean;
  isTutorialRun: boolean;
}

export interface PermaState {
  /** 永久档案谱系；跨周目稳定，与 runId 分层，不由展示名称或设备标识派生。 */
  profileId: string;
  currency: Record<string, GameNum>;
  racePillars: Record<RaceId, number>;
  achievements: string[];
  /** v0.3 FR-26：每个宇宙独立记录通关种族与最高星级。 */
  universes: Record<Id, UniverseRecord>;
  /**
   * v0.4.1: 各重置层已执行次数（多层重置的成长空间状态基础，也是 A2 解锁条件 resetLayer 的求值依据）。
   * 键固定为 'ash'（灰烬协议）与 'seed'（播种协议）两层；值为非负整数次数（初始 0）。
   */
  resetCounts: Record<'ash' | 'seed', number>;
  /** v0.4：V1.0 恒为空对象，类型层面限定为空（Record<string, never>），禁止塞入任意字段；后续版本再放开。 */
  extras: Record<string, never>;
}

export type StarLevel = 0 | 1 | 2 | 3 | 4;

export interface UniverseRecord {
  clearedRaces: RaceId[];
  maxStar: StarLevel;
}

export interface RunState {
  /** v0.3 FR-25/26：周目开始时选定并锁定，周目内不可更改。 */
  universeId: Id;
  starLevel: StarLevel;
  civ: CivState;
  resources: Record<ResId, ResourceState>;
  buildings: Record<BuildingId, BuildingState>;
  jobs: Record<JobId, JobState>;
  chains: Record<string, ChainState>;
  techs: TechId[];
  governor: GovernorState;
  eco: EcoState;
  orders: OrdersState;
  timers: TimersState;
  /** v0.4 FR-51：邻国博弈与统一的权威状态（架构 5.8）；随 run 存档并进入规范状态哈希，不得只存在于展示层。 */
  diplomacy: DiplomacyState;
  /** v0.4.1: C7 政体（纪元 1–4 恒 'anarchy'，纪元 5 可选择；仅冷却无产出惩罚）。 */
  government: GovernmentState;
  /** v0.4.1: C8 FR-22 L1–L4 失败梯度（tier 0 为正常）。 */
  failure: FailureState;
  /** v0.4.1: C9 纪元 7 母星折叠（纪元 7 前恒 folded:false）。 */
  homeworldFold: HomeworldFoldState;
}

export interface CivState {
  eraIndex: number;
  raceId: RaceId | null;
  /** 新手引导阶段，属于引擎状态（FR-28、架构 5.7）。 */
  tutorialStage: number;
  pollution: number;
  morale: number;
}

export interface ResourceState {
  amount: GameNum;
  /** 当前上限由阶段 1 重算后缓存。 */
  max: GameNum;
  unlocked: boolean;
}

export interface BuildingState {
  count: number;
  active: number;
  sockets: Array<CatalystId | null>;
}

export interface JobState {
  workers: number;
  masteryLevel: number;
  masteryXp: GameNum;
}

export type ChainLevel = 0 | 1 | 2 | 3;

export interface ChainState {
  starveTimerSec: number;
  level: ChainLevel;
  warmupRemainingSec: number;
  /** 一级是否已确认并记录（l1ConfirmSec），避免重复写日志。 */
  l1Confirmed: boolean;
}

export interface GovernorState {
  rules: GovernorRule[];
  queue: QueueItem[];
  queueMode: 'strict' | 'smart';
}

export interface GovernorRule {
  id: string;
  enabled: boolean;
  /** 监控的资源，使用 ResId 或 'sustenance' 别名（由种族声明解析）。 */
  watch: ResId | 'sustenance';
  triggerRatio: number;
  releaseRatio: number;
  cooldownUntilTick: number;
  /** 已被本规则抽调的人数，释放时归还。 */
  drafted: Record<JobId, number>;
  drawOrder: JobId[];
  toJob: JobId | 'sustenance';
  priority: number;
}

export interface QueueItem {
  id: string;
  type: 'building' | 'tech';
  targetId: Id;
  /** 成本超过当前上限时被标记，智能模式下会被越过。 */
  blockedByCap: boolean;
  /** v0.3 FR-19：最大可接受成本，超过则暂停并提示，避免离线时被蠕变吃光资源；不设表示不限。 */
  maxAcceptableCost?: Record<ResId, GameNum>;
  /** v0.3 FR-19：因超过最大可接受成本而暂停。 */
  pausedByCost: boolean;
}

export interface EcoState {
  grid: EcoSlot[];
  catalysts: Record<CatalystId, number>;
}

export interface EcoSlot {
  index: number;
  seedId: SeedId | null;
  progressTicks: number;
  totalTicks: number;
  autoReplant: boolean;
}

export interface OrdersState {
  /** 商队订单上次刷新的 tick；满 24 小时滚动刷新（FR-17），以 tick 计，不依赖挂钟。 */
  lastRefreshTick: number;
  open: Array<{ id: string; wants: Record<Id, number>; rewardId: Id }>;
}

export interface TimersState {
  lastHazardGridTick: number;
  collapseCountdownTicks: number | null;
}

// ---------------------------------------------------------------------------
// FR-51 邻国博弈与统一（架构 5.8）：权威状态，仅结构占位，不含实现
// ---------------------------------------------------------------------------

/** 统一路线（FR-51）：武力 / 财团 / 文化。只影响叙事与成就，不改变重置货币公式。 */
export type UnificationRoute = 'military' | 'syndicate' | 'culture';

/** 单个邻国的缓慢演化量；三项均由配置初值经游戏秒缓慢变化，并由宿主事件跳跃精确求点（组 J）。 */
export interface NeighborState {
  /** 邻国 ID，来自配置（纪元 4 起为 3，可配置）。 */
  id: Id;
  /** 军力：出兵掠夺按此对比结算并产生伤亡（FR-22：伤亡不导致死局）。 */
  military: number;
  /** 关系：贸易与外交提高，间谍可破坏。 */
  relation: number;
  /** 动荡：文化统一需把关系推高且动荡压低（阈值来自配置）。 */
  unrest: number;
}

/** 贸易路线（FR-51 贸易行动产物，事件登记组 K）。 */
export interface TradeRoute {
  routeId: Id;
  targetId: Id;
  volumeTier: number;
  establishedAtTick: number;
  nextSettleTick: number;
}

/** 统一进度。统一完成且 armyAllHome 为真后，灰烬协议（FR-23）才放行（引擎级门禁）。 */
export interface UnificationProgress {
  route: UnificationRoute | null;
  unified: boolean;
  armyAllHome: boolean;
}

/**
 * FR-51 邻国博弈与统一的权威状态段（架构 5.8）。
 * - 军力 / 关系 / 动荡是缓慢演化量，全由配置初值与派生的慢变率决定；
 * - 每邻国的行动冷却按配置的游戏秒声明，此处以 tick 记录结束时刻（不读挂钟）；
 * - 贸易路线列表、统一进度是本段其余语义；整体进入规范状态哈希。
 */
export interface DiplomacyState {
  neighbors: Record<Id, NeighborState>;
  /** 每邻国下次可行动的最早 tick（按配置冷却，确定性推进）。 */
  actionCooldownUntilTick: Record<Id, number>;
  tradeRoutes: TradeRoute[];
  unification: UnificationProgress;
}

// ---------------------------------------------------------------------------
// C7/C8/C9 占位状态（批次三）：政体 / 失败梯度 / 母星折叠（仅结构，不含实现）
// ---------------------------------------------------------------------------

/** v0.4.1: C7 政体 ID（引用 Id；具体取值由配置 GovernmentConfig 声明）。 */
export type GovernmentId = Id;

/**
 * v0.4.1: C7 政体状态（GDD v0.26 收口口径），挂到 RunState.government。
 * 【纪元阈值】纪元 1–4 恒为 'anarchy'（不可选择）；纪元 5 起可选择（unlockEraIndex=5，见 GovernmentConfig）。
 * 【惩罚口径】旧 GDD 的「政变期 -30% 产出惩罚」已废止；切换政体只有冷却限制，无产出惩罚。
 * 【关联配置】GovernmentConfig 属 configs 包（依赖方向：engine 只 import configs，不反向定义；
 *   本批已在 configs/types.ts 小幅追加该接口与 GameConfig.governments 可选字段）。
 */
export interface GovernmentState {
  /** 当前政体；'anarchy' 为纪元 1–4 的恒定占位， 表示尚未初始化。 */
  current: GovernmentId | 'anarchy' | null;
  /** 切换冷却结束的最早 tick（不读挂钟，确定性推进）；冷却中拒绝切换。 */
  switchCooldownUntilTick: number;
  /** 本局已切换政体次数（配合 GovernmentConfig.maxSwitchesPerRun 上限校验）。 */
  switchesThisRun: number;
}

/**
 * v0.4.1: C8 FR-22 L1–L4 失败梯度泛化，挂到 RunState.failure。
 * 把「污染持续超阈要持续多久」这类问题状态化：tier 0 为正常，tier 1–4 对应 L1–L4 失败梯度，
 * durationTicks 记录当前梯度已持续的 tick 数（事件点 7 的 failure_duration TIMER 成员据此推进/重置）。
 */
export interface FailureState {
  tier: 0 | 1 | 2 | 3 | 4;
  durationTicks: number;
}

/**
 * v0.4.1: C9 纪元 7 母星折叠状态，挂到 RunState.homeworldFold。
 * 【语义】纪元 7 触发母星折叠：折叠后 70% 托管效率（占位值，待评审），且不可逆；
 * 快照当期各资源速率（snapshotRates）以供折叠后托管结算。
 * 【占位】纪元 7 前恒为 folded:false；折叠效率为占位，评审后再定稿。
 */
export interface HomeworldFoldState {
  folded: boolean;
  foldedAtTick: number | null;
  snapshotRates: Record<Id, GameNum> | null;
}

// ---------------------------------------------------------------------------
// 命令与事件
// ---------------------------------------------------------------------------

export type GameCommand =
  | { type: 'CHOOSE_RACE'; raceId: RaceId }
  | { type: 'BUILD'; buildingId: BuildingId; count: number }
  | { type: 'SET_BUILDING_ACTIVE'; buildingId: BuildingId; active: number }
  | { type: 'ASSIGN_JOB'; jobId: JobId; delta: number }
  | { type: 'RESEARCH'; techId: TechId }
  | { type: 'QUEUE_ADD'; item: Omit<QueueItem, 'blockedByCap' | 'pausedByCost'> }
  | { type: 'QUEUE_REMOVE'; itemId: string }
  | { type: 'QUEUE_MOVE'; itemId: string; toIndex: number }
  | { type: 'QUEUE_SET_MODE'; mode: 'strict' | 'smart' }
  | { type: 'GOV_RULE_UPSERT'; rule: GovernorRule }
  | { type: 'GOV_RULE_REMOVE'; ruleId: string }
  | { type: 'ECO_PLANT'; slotIndex: number; seedId: SeedId }
  | { type: 'ECO_SOCKET'; buildingId: BuildingId; socketIndex: number; catalystId: CatalystId | null }
  | { type: 'ADVANCE_ERA' }
  /** seed 与 runId 由调用方生成并随命令记录，引擎自身不产生随机数与时间。 */
  | { type: 'RESET'; layer: 'ash' | 'seed'; seed: number; runId: string; universeId: Id; starLevel: StarLevel }
  // ---- FR-51 邻国行动（四类）+ 统一路线 + 灰烬协议前置（架构 5.8）----
  // 携带 neighborId 与目标参数，但都【不携带 atTick】：由 Worker 宿主赋权威 atTick（架构 6.1）。
  // 资源／人口／行政算力消耗、冷却与成败判定在 dispatch 内结算；统一路线只判 unified，不改货币公式。
  /** 贸易：订立或中断与邻国的贸易路线（换取本国缺的材料）。 */
  | { type: 'DIPLOMACY_TRADE'; neighborId: Id; action: 'establish' | 'break'; volumeTier: number }
  /** 出兵：按军力对比结算掠夺，有伤亡（伤亡不导致死局，FR-22）。 */
  | { type: 'DIPLOMACY_INVADE'; neighborId: Id }
  /** 间谍：侦察 / 破坏 / 煽动（煽动提高动荡，服务文化路线）。 */
  | { type: 'DIPLOMACY_SPY'; neighborId: Id; mode: 'recon' | 'sabotage' | 'incite' }
  /** 外交：提高与邻国的关系。 */
  | { type: 'DIPLOMACY_TALK'; neighborId: Id }
  /** 选择统一路线（武力 / 财团 / 文化）；只判 unified 与成就，不进入产物结算路径。 */
  | { type: 'DIPLOMACY_SET_ROUTE'; route: UnificationRoute }
  /** 启动灰烬协议（FR-23）：applyDueCommands 时校验，仅当 unified === true 且 armyAllHome === true 才放行，否则返回被拒事件。 */
  | { type: 'DIPLOMACY_START_ASH_PROTOCOL' }
  /** v0.4.1: C7 选择政体（仅纪元 ≥5 可用，冷却中拒绝，次数超展拒绝）。 */
  | { type: 'GOVERNMENT_CHOOSE'; governmentId: GovernmentId };

/** 事件组（架构 5.2.2 事件源登记表 A→K）：组序即同 tick 内事件处理顺序，A 先、K 后。 */
export type EventGroup = 'A' | 'B' | 'C' | 'D' | 'E' | 'F' | 'G' | 'H' | 'I' | 'J' | 'K';

/**
 * 事件种类。DIAG 独立于登记表组，用于段数异常等诊断（架构 5.2.10），不参与玩法结算。
 * 具体负载按 kind 判别（见下方 EventPayloadByKind），避免把事件塞成无类型的空泛对象。
 */
export type EventKind =
  | 'RESOURCE_BOUNDARY'
  | 'THRESHOLD'
  | 'QUEUE_EXECUTABLE'
  | 'ECO_MATURITY'
  | 'CHAIN_LEVEL'
  | 'MASTERY_MILESTONE'
  | 'TIMER'
  | 'HAZARD_SAMPLE'
  | 'COMMAND_BOUNDARY'
  | 'NEIGHBOR_CHANGE'
  | 'TRADE_ROUTE'
  | 'DIAG';

/** 按 kind 判别的负载；旧事件字段（如 wastedPerSec、chainId、ruleId 等）保留在这些负载里以便迁移。 */
export interface EventPayloadByKind {
  RESOURCE_BOUNDARY: { resId: ResId; boundary: 'full' | 'empty'; wastedPerSec: GameNum };
  THRESHOLD: { source: string; threshold: string; crossed: 'up' | 'down' };
  QUEUE_EXECUTABLE: { itemId: string };
  ECO_MATURITY: { slotIndex: number };
  CHAIN_LEVEL: { chainId: string; level: ChainLevel };
  MASTERY_MILESTONE: { jobId: JobId; level: number };
  TIMER: { timer: 'cooldown' | 'pollution_collapse' | 'season' | 'orders_refresh' | 'government_cooldown' | 'failure_duration' | 'neighbor_slow_change' };
  HAZARD_SAMPLE: { gridIndex: number };
  COMMAND_BOUNDARY: { cmdSeq: number; commandId: string };
  NEIGHBOR_CHANGE: { neighborId: Id; field: 'military' | 'relation' | 'unrest'; cooldownEnded: boolean };
  TRADE_ROUTE: { routeId: string; targetId: Id; change: 'open' | 'close' | 'volume' | 'settle' };
  DIAG: { code: string; detail?: string };
}

/**
 * 通用事件契约（架构 5.2.9）：
 * - atMilli：整数毫秒事件时刻（= currentTick*tickMs + subMilli，绝对时间轴）；
 * - seq：同一 tick 内的稳定序号，配合 atMilli 保证事件序列可重放；
 * - group：事件组 A→K，明确表达同 tick 固定顺序（诊断事件可携带其来源组）；
 * - kind：事件种类；payload：按 kind 判别的有类型负载。
 * 判别联合保证 kind 与 payload 结构一致，不会退化成空泛 payload。
 */
export type SimEvent = {
  [K in EventKind]: {
    atMilli: number;
    seq: number;
    group: EventGroup;
    kind: K;
    payload: EventPayloadByKind[K];
  };
}[EventKind];

/** 旧事件形状保留为类型别名以便迁移；用于迁移期对照，不参与新契约运行时。 */
export type LegacySimEvent =
  | { type: 'CHAIN_LEVEL'; chainId: string; level: ChainLevel; atTick: number }
  | { type: 'RESOURCE_OVERFLOW'; resId: ResId; wastedPerSec: GameNum; atTick: number }
  | { type: 'ERA_ADVANCED'; eraIndex: number; atTick: number }
  | { type: 'ORDERS_REFRESHED'; atTick: number }
  | { type: 'GOVERNOR_TRIGGERED'; ruleId: string; atTick: number }
  | { type: 'GOVERNOR_RELEASED'; ruleId: string; atTick: number };

/** 精确推进结果；24 小时截断由宿主 settleElapsedTime 负责，不混入引擎。 */
export interface SimResult {
  events: SimEvent[];
  segmentsRun: number;
  /** 本次从预算整 tick 中已完整消费的整数 tick 数（= budget.ticks − remainingTicks）。 */
  ticksAdvanced: number;
  /** 预算中尚未消费的完整整数 tick 数（向下取整，不 ceil）。 */
  remainingTicks: number;
  /** 预算中尚未消费的整数毫秒余量，0 <= remainingMs < tickMs；宿主下次原样放进 SegmentBudget.remainingMs 续算，绝不 ceil 成整 tick。 */
  remainingMs: number;
  /** remainingTicks === 0 && remainingMs === 0。 */
  completed: boolean;
}

/** 一次时间片的执行预算；仅影响让出节拍，不影响模拟结果。 */
export interface SegmentBudget {
  /** 本次要推进的完整 tick 数，由宿主计算；恒为整数。 */
  ticks: number;
  /** 进入本次调用时 tick 内的整数毫秒余量，0 <= remainingMs < tickMs；首次为 0，续算时把上次 SimResult.remainingMs 原样传入（宿主不得 ceil 成整 tick）。 */
  remainingMs: number;
  /** 本时间片最多执行的段数；只影响让出节拍，不影响结果。 */
  maxSegmentsThisSlice: number;
}

export interface CommandResult {
  ok: boolean;
  /** 失败时给出可展示的原因代码（snake_case），由本地化表翻译；引擎代码里不写自然语言。 */
  reason?: string;
}
